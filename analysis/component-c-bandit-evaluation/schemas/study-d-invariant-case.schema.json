{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "component-c-study-d-invariant-case-v1.schema.json",
  "title": "Component C deterministic invariant case",
  "type": "object",
  "required": [
    "schema_version", "protocol_id", "study", "case_id", "category",
    "exact_input", "proposed_action", "validation_outcome",
    "executed_state", "reward_disposition", "model_update_count",
    "expected", "actual", "passed"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "protocol_id": {"const": "component-c-simulation-evaluation-v1.2"},
    "study": {"const": "study-d"},
    "case_id": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "exact_input": {"type": "object"},
    "proposed_action": {"type": ["string", "null"]},
    "validation_outcome": {"type": "string"},
    "executed_state": {"type": ["object", "null"]},
    "reward_disposition": {"type": "string"},
    "model_update_count": {"type": "integer", "minimum": 0},
    "expected": {"type": "string"},
    "actual": {"type": "string"},
    "passed": {"type": "boolean"}
  },
  "additionalProperties": false
}
