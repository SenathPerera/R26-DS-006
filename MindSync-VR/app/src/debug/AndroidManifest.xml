<?xml version="1.0" encoding="utf-8"?>
<!-- Debug overlay: points the app at the debug network security config so it can
     reach Component D over cleartext HTTP during development. Merged into the
     main manifest for debug builds only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
