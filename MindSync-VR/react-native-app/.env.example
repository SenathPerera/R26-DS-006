# Supabase client configuration. Use the publishable/anon client key only.
# Never put a service_role or secret key in a mobile application.
SUPABASE_ENABLED=true
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Windows PC hostname or LAN IPv4 address that runs Component B, Component D,
# the session relay, and the Lyria backend. Do not include http:// or a port.
# Required for standalone release APKs; use the PC's current Wi-Fi address.
PILOT_BACKEND_HOST=

# Required before preparing a production VR session. Assignment is explicit,
# immutable for that session, and forwarded to Quest.
STUDY_CONDITION=StaticPersonalized
