.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# artifacts and data are large / private.
# The whole artifacts/ tree is ignored — models, scalers, config AND the
# exported parity fixture. A file is identified by the SHA-256 fingerprints
# in docs/ARCHITECTURE.md §3, not by being committed.
artifacts/**
!artifacts/**/
!artifacts/**/.gitkeep

data/raw/*
data/processed/*
data/replay/*
!data/**/.gitkeep

.env
.DS_Store
