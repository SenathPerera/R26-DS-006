{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindsync.local/contracts/session/mindsync-session-v3.schema.json",
  "title": "MindSync Mobile-to-Quest Session Contract v3",
  "oneOf": [
    {"$ref": "#/$defs/createSessionRequest"},
    {"$ref": "#/$defs/sessionConfigurationEnvelope"}
  ],
  "$defs": {
    "studyCondition": {
      "enum": [
        "StaticPersonalized",
        "RuleBasedAdaptive",
        "ContextualBandit"
      ]
    },
    "preferredEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "illumination",
        "warmth",
        "atmosphericSoftness",
        "colorRichness",
        "ambientMotion"
      ],
      "properties": {
        "illumination": {"type": "number", "minimum": 0, "maximum": 1},
        "warmth": {"type": "number", "minimum": 0, "maximum": 1},
        "atmosphericSoftness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "colorRichness": {"type": "number", "minimum": 0, "maximum": 1},
        "ambientMotion": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "sessionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "collectedAt",
        "subjectiveStress",
        "moodValence",
        "fatigue",
        "sleepQuality",
        "headacheOrEyeStrainToday",
        "timeOfDayMinutes",
        "sessionSequenceNumber",
        "daysSincePreviousSession"
      ],
      "properties": {
        "schemaVersion": {"const": "mindsync-session-context-v1"},
        "collectedAt": {"type": "string", "format": "date-time"},
        "subjectiveStress": {"type": "number", "minimum": 0, "maximum": 10},
        "moodValence": {"type": "number", "minimum": -1, "maximum": 1},
        "fatigue": {"type": "number", "minimum": 0, "maximum": 1},
        "sleepQuality": {"type": "number", "minimum": 0, "maximum": 1},
        "headacheOrEyeStrainToday": {"type": "boolean"},
        "timeOfDayMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1439
        },
        "sessionSequenceNumber": {"type": "integer", "minimum": 1},
        "daysSincePreviousSession": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "audioControlPreferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferredInstruments", "mood", "tempoPreference", "audioIntensity",
        "ambientMusicBalance", "brightnessPreference", "noveltyTolerance",
        "avoidDissonance", "rhythmPreference", "natureSoundPreference",
        "reverbPreference", "volumePreference"
      ],
      "properties": {
        "preferredInstruments": {
          "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true,
          "items": {"enum": ["piano", "flute", "pad", "strings", "bells", "drone"]}
        },
        "mood": {"enum": ["calm", "focused", "sleepy", "energized"]},
        "tempoPreference": {"enum": ["slow", "medium", "fast"]},
        "audioIntensity": {"type": "number", "minimum": 0, "maximum": 1},
        "ambientMusicBalance": {"enum": ["mostly_ambience", "balanced", "mostly_music"]},
        "brightnessPreference": {"enum": ["soft_dark", "neutral", "bright_clear"]},
        "noveltyTolerance": {"type": "number", "minimum": 0, "maximum": 1},
        "avoidDissonance": {"type": "boolean"},
        "rhythmPreference": {"enum": ["minimal", "gentle_pulse", "more_motion"]},
        "natureSoundPreference": {"enum": ["none", "low", "medium", "high"]},
        "reverbPreference": {"enum": ["dry", "balanced", "spacious"]},
        "volumePreference": {"enum": ["low", "medium", "high"]}
      }
    },
    "audioPreferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "longTerm", "preferenceMode", "sessionOverride"],
      "properties": {
        "schemaVersion": {"const": "mindsync-audio-preferences-v1"},
        "longTerm": {"$ref": "#/$defs/audioControlPreferences"},
        "preferenceMode": {"enum": ["usual", "adjust"]},
        "sessionOverride": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/audioControlPreferences"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"preferenceMode": {"const": "adjust"}}},
          "then": {"properties": {"sessionOverride": {"$ref": "#/$defs/audioControlPreferences"}}},
          "else": {"properties": {"sessionOverride": {"type": "null"}}}
        }
      ]
    },
    "createSessionRequest": {
      "title": "Create prepared session request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "participantPseudonym",
        "sceneId",
        "studyCondition",
        "preferredEnvironment",
        "sessionContext"
      ],
      "properties": {
        "requestId": {"type": "string", "minLength": 1, "maxLength": 128},
        "participantPseudonym": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sceneId": {"const": "temple-pond"},
        "studyCondition": {"$ref": "#/$defs/studyCondition"},
        "preferredEnvironment": {"$ref": "#/$defs/preferredEnvironment"},
        "sessionContext": {"$ref": "#/$defs/sessionContext"},
        "audioPreferences": {"$ref": "#/$defs/audioPreferences"}
      }
    },
    "sessionConfigurationEnvelope": {
      "title": "Quest session-configuration envelope",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "messageId", "messageType", "payload"],
      "properties": {
        "schemaVersion": {"const": "mindsync-session-v3"},
        "messageId": {"type": "string", "minLength": 1},
        "messageType": {"const": "session_configuration"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionId",
            "participantPseudonym",
            "sceneId",
            "studyCondition",
            "preferredEnvironment",
            "sessionContext"
          ],
          "properties": {
            "sessionId": {"type": "string", "minLength": 1},
            "participantPseudonym": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "sceneId": {"const": "temple-pond"},
            "studyCondition": {"$ref": "#/$defs/studyCondition"},
            "preferredEnvironment": {
              "$ref": "#/$defs/preferredEnvironment"
            },
            "sessionContext": {"$ref": "#/$defs/sessionContext"},
            "audioPreferences": {"$ref": "#/$defs/audioPreferences"}
          }
        }
      }
    }
  }
}
